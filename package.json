{
  "name": "backchannel-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup:env": "python3 scripts/setup_env.py",
    "setup:server": "uv sync --project server --locked",
    "check:services": "python3 scripts/preflight.py",
    "dev": "npm --prefix client run dev",
    "dev:server": "uv run --directory server --locked python main.py",
    "dev:client": "npm run dev",
    "build": "npm --prefix client run build",
    "test:server": "uv run --directory server --locked python -m unittest discover -s tests -v",
    "verify:live": "uv run --project server --locked python scripts/integration.py",
    "setup:browser": "PLAYWRIGHT_BROWSERS_PATH=/tmp/backchannel-playwright playwright install --no-shell chromium",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=/tmp/backchannel-playwright node scripts/browser.mjs",
    "test:storage": "uv run --project server --locked python scripts/storage_probe.py",
    "test:fixture-server": "uv run --project server --locked uvicorn integration.fixture_app:app --host 127.0.0.1 --port 8000"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
